{
  "$id": "https://ioggstream.github.io/draft-polli-restapi-ld-keywords/vocab/table-schema-jsonld.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$dynamicAnchor": "meta",
  "title": "Table Schema with JSON-LD Extensions",
  "description": "A JSON Schema that extends Frictionless Data Table Schema with JSON-LD annotations",
  "allOf": [
    {
      "$ref": "https://specs.frictionlessdata.io/schemas/table-schema.json"
    },
    {
      "$ref": "https://ioggstream.github.io/draft-polli-restapi-ld-keywords/vocab/jsonld-meta.json"
    }
  ],
  "examples": [
    {
      "x-jsonld-type": "skos:Concept",
      "x-jsonld-context": {
        "skos": "http://www.w3.org/2004/02/skos/core#",
        "dct": "http://purl.org/dc/terms/",
        "xsd": "http://www.w3.org/2001/XMLSchema#",
        "id": "skos:notation",
        "name": "skos:prefLabel",
        "url": "@id",
        "created": {
          "@id": "dct:created",
          "@type": "xsd:dateTime"
        },
        "description": null
      },
      "fields": [
        {
          "name": "url",
          "type": "string",
          "description": "URL of the resource"
        },
        {
          "name": "id",
          "type": "string",
          "description": "Unique identifier"
        },
        {
          "name": "name",
          "type": "string",
          "description": "Name of the person"
        },
        {
          "name": "created",
          "type": "string",
          "description": "Creation date of the record"
        },
        {
          "name": "description",
          "type": "string",
          "description": "Description of the resource"
        }
      ],
      "primaryKey": "id"
    },
    {
      "fields": [
        {
          "name": "product_id",
          "type": "integer",
          "description": "Unique product identifier"
        },
        {
          "name": "product_name",
          "type": "string",
          "description": "Name of the product"
        },
        {
          "name": "price",
          "type": "number",
          "description": "Price of the product",
          "constraints": {
            "minimum": 0
          }
        },
        {
          "name": "in_stock",
          "type": "boolean",
          "description": "Availability of the product"
        }
      ],
      "primaryKey": "product_id"
    }
  ]
}
